# KARIGAR X Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# ──────────────────────────────────────────────────────────────────────────────
# Google Gemini (for product image analysis & catalogue generation)
# Free tier available at: https://aistudio.google.com/app/apikey
# ──────────────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Stability AI (for AI Product Photo Studio - retained for rollback)
# Get your key at: https://platform.stability.ai/account/keys
# ──────────────────────────────────────────────────────────────────────────────
STABILITY_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Bria AI (Primary AI Product Photo Studio Provider)
# Get your token at: https://bria.ai/
# ──────────────────────────────────────────────────────────────────────────────
BRIA_API_TOKEN=

# ──────────────────────────────────────────────────────────────────────────────
# Photo Studio Provider Selection
# Options: 'bria' (default if BRIA_API_TOKEN set), 'stability', 'demo'
# ──────────────────────────────────────────────────────────────────────────────
PHOTO_STUDIO_PROVIDER=bria
